POSTGRES_DB=etrn_flow
POSTGRES_USER=etrn_flow
POSTGRES_PASSWORD=replace-with-a-strong-production-password
DATABASE_URL=postgres://etrn_flow:replace-with-a-strong-production-password@postgres:5432/etrn_flow
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info
GUEST_SESSION_COOKIE_NAME=etrn_guest_session
GUEST_SESSION_TTL_SECONDS=86400
GUEST_SESSION_COOKIE_SECURE=true
GUEST_SESSION_COOKIE_SAME_SITE=lax
GUEST_SESSION_MUTATION_LIMIT=60
GUEST_SESSION_RESET_LIMIT=8
GUEST_SESSION_RATE_WINDOW_SECONDS=10
GUEST_SESSION_RATE_MAX_REQUESTS=8
